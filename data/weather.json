      {
        "id": "urn:oid:2.49.0.1.840.0.cc8eba4b7267b1441f0023db3a3579cdf55fe55b.001.1",
        "event": "Flood Advisory",
        "headline": "Flood Advisory issued August 31 at 10:39PM AKDT until September 1 at 6:30AM AKDT by NWS Juneau AK",
        "description": "Rain showers continue to move across the area this evening bringing\nperiods of moderate to heavy rain for the Juneau area. Rainfall\namounts around the Mendenhall Valley show around an inch of rain has\nfallen in the last six hours with between another quarter to three\nquarters of an inch possible.\n\n* WHAT...Flooding caused by excessive rainfall is expected.\n\n* WHERE...Montana Creek near areas near the low water crossing on\nMontana Creek Road and near Back Loop Road at the Montana Creek\nbridge.\n\n*",
        "severity": "Minor",
        "certainty": "Likely",
        "urgency": "Expected",
        "sender": "NWS Juneau AK",
        "effective": "2026-08-31T22:39:00-08:00",
        "expires": "2026-09-01T06:30:00-08:00",
        "areas": "City and Borough of Juneau",
        "category": "Met",
        "response": "Avoid",
        "instruction": "Stay tuned to further developments by listening to your local radio,\ntelevision, or NOAA Weather Radio for further information.\n\nBe especially cautious at night when it is harder to recognize the\ndangers of flooding.\n\nBe aware of your surroundings and do not drive on flooded roads.",
        "lat": 58.41285714285714,
        "lng": -134.62
      },
      {
        "id": "urn:oid:2.49.0.1.840.0.4e6b8a8d6773dab4b9a6831eaba864a5bc9f829f.001.1",
        "event": "Special Weather Statement",
        "headline": "Special Weather Statement issued August 31 at 5:10PM AKDT by NWS Anchorage AK",
        "description": "Strong northwesterly winds have developed across Shelikof Strait\nand the waters around southern Kodiak Island. These winds are\nresuspending ash from the 1912 Katmai-Novarupta eruption,\ncausing haze and potentially trace amounts of ash accumulation.\nThe villages of Karluk, Larsen Bay and Akhiok are most likely to\nbe impacted.\n\nThose in sensitive groups or with respiratory ailments are\nencouraged to avoid or reduce outdoor activity to avoid inhaling\nthe ash. The winds should weaken and shift brief",
        "severity": "Moderate",
        "certainty": "Observed",
        "urgency": "Expected",
        "sender": "NWS Anchorage AK",
        "effective": "2026-08-31T17:10:00-08:00",
        "expires": "2026-09-01T10:00:00-08:00",
        "areas": "Kodiak Island Southwest",
        "category": "Met",
        "response": "Execute",
        "instruction": "",
        "lat": null,
        "lng": null
      },

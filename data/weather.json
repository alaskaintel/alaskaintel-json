      {
        "id": "urn:oid:2.49.0.1.840.0.db87d4d7aefd1052ea8e530b0ac97158680c3a97.001.1",
        "event": "Special Weather Statement",
        "headline": "Special Weather Statement issued September 27 at 1:58PM AKDT by NWS Fairbanks AK",
        "description": "Cooler temperatures will allow for the first chance for snowfall\naccumulations. While snow could be seen in some low lying areas in\nand around Fairbanks, the best chance for accumulations will be\nat higher elevations. Snowfall accumulations from Monday night\nthrough Wednesday night are expected to be between 1\" and 3\". Any\nsnow that falls in the lower elevations will be very wet and will\nmostly likely melt during the day with high temperatures remaining\nin the low 40s.",
        "severity": "Moderate",
        "certainty": "Observed",
        "urgency": "Expected",
        "sender": "NWS Fairbanks AK",
        "effective": "2026-09-27T13:58:00-08:00",
        "expires": "2026-09-28T16:00:00-08:00",
        "areas": "Dalton Highway Summits; White Mountains and High Terrain South of the Yukon River; Upper Chena River Valley; Eielson AFB and Salcha; Chatanika River Valley; Two Rivers; Fairbanks Metro Area",
        "category": "Met",
        "response": "Execute",
        "instruction": "",
        "lat": null,
        "lng": null
      },
      {
        "id": "urn:oid:2.49.0.1.840.0.db87d4d7aefd1052ea8e530b0ac97158680c3a97.002.1",
        "event": "Special Weather Statement",
        "headline": "Special Weather Statement issued September 27 at 1:58PM AKDT by NWS Fairbanks AK",
        "description": "Snowfall beginning Monday night could potentially lead to slick\ntravel conditions along Isabel Pass beginning Monday night.\nCooler temperatures are expected to settle in through mid week\nwhich could allow for the first accumulations of the season.\nUp to 6\" is possible through Wednesday night. This could be the\nstart of the permanent snow pack.",
        "severity": "Moderate",
        "certainty": "Observed",
        "urgency": "Expected",
        "sender": "NWS Fairbanks AK",
        "effective": "2026-09-27T13:58:00-08:00",

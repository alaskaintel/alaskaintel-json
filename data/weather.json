      {
        "id": "urn:oid:2.49.0.1.840.0.929f8940bfb065b7cc16b601d954955501d23905.001.1",
        "event": "Special Weather Statement",
        "headline": "Special Weather Statement issued July 15 at 9:12PM AKDT by NWS Juneau AK",
        "description": "A glacier dammed lake outburst from Summit Lake continues on the\nSalmon River near Hyder. Water levels as of 9 pm Wednesday are at\n25.0 ft at the river gage. Which is around 6 ft higher then what it\nwas at before the event started. Water levels are expected to\ncontinue to rise through Wednesday night with an expected crest\noccurring either Wednesday night or Thursday. It is unknown how much\nwater will be released from Summit Lake which results in large\nuncertainty on crest height and timing.\n\nPo",
        "severity": "Moderate",
        "certainty": "Observed",
        "urgency": "Expected",
        "sender": "NWS Juneau AK",
        "effective": "2026-07-15T21:12:00-08:00",
        "expires": "2026-07-16T05:15:00-08:00",
        "areas": "City of Hyder",
        "category": "Met",
        "response": "Execute",
        "instruction": "",
        "lat": null,
        "lng": null
      },

        "effective": "2026-08-28T12:58:00-08:00",
        "expires": "2026-08-29T07:00:00-08:00",
        "areas": "Central Brooks Range",
        "category": "Met",
        "response": "Execute",
        "instruction": "Slow down and use caution while traveling. Visit 511.alaska.gov or\ncall 5 1 1 for the latest road conditions.",
        "lat": null,
        "lng": null
      },
      {
        "id": "urn:oid:2.49.0.1.840.0.e54729f9410399d9330f98efb928e6059b83bfd5.001.1",
        "event": "Special Weather Statement",
        "headline": "Special Weather Statement issued August 28 at 9:01AM AKDT by NWS Fairbanks AK",
        "description": "Rainfall across much of the Central Interior, including the\nFairbanks North Star Borough becomes more scattered and showery in\nthe afternoon. As this happens drier air brings gusty west-\nsouthwest winds to the area Friday evening. Gusts in the 25 to 35\nmph range are expected to continue through Saturday. Overnight\nFriday and in the early morning Saturday deeper valleys may see\nlighter winds, but occasional gusts in the 25 to 35 mph range will\nstill be possible. Winds weaken Saturday evening and ",
        "severity": "Moderate",
        "certainty": "Observed",
        "urgency": "Expected",

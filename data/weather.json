        "id": "urn:oid:2.49.0.1.840.0.2f810f4e46839b2720d2dad4f7f3aead8c724800.001.1",
        "event": "Winter Weather Advisory",
        "headline": "Winter Weather Advisory issued August 30 at 4:22AM AKDT until September 1 at 4:00AM AKDT by NWS Fairbanks AK",
        "description": "* WHAT...Snow and breezy winds expected. Total snow accumulations of\n5 to 8 inches across higher elevations of the Richardson Highway\nnorth of Isabel Pass, with heavier amounts above pass level. Winds\ngusting as high as 40 mph.\n\n* WHERE...Eastern Alaska Range.\n\n* WHEN...From midnight tonight to 4 AM AKDT Tuesday.\n\n* IMPACTS...Travel could be difficult. Areas of blowing snow could\nsignificantly reduce visibility.\n\n* ADDITIONAL DETAILS...Rain will quickly transition to snow overnight\ntonight, with",
        "severity": "Moderate",
        "certainty": "Likely",
        "urgency": "Expected",
        "sender": "NWS Fairbanks AK",
        "effective": "2026-08-30T04:22:00-08:00",
        "expires": "2026-08-30T16:00:00-08:00",
        "areas": "Eastern Alaska Range North of Trims Camp; Eastern Alaska Range South of Trims Camp",
        "category": "Met",
        "response": "Execute",
        "instruction": "Slow down and use caution while traveling. Visit 511.alaska.gov or\ncall 5 1 1 for the latest road conditions.",
        "lat": null,
        "lng": null
      },
      {
        "id": "urn:oid:2.49.0.1.840.0.c5200b9bdc8ffa3645c3074dd8fba206a44641eb.001.1",
        "event": "Special Weather Statement",
        "headline": "Special Weather Statement issued August 29 at 7:38PM AKDT by NWS Anchorage AK",
        "description": "Strong northwesterly winds have developed across Shelikof Strait\nand the waters around southern Kodiak Island. These winds are\nresuspending ash from the 1912 Katmai-Novarupta eruption,\npotentially causing haze and trace amounts of ash accumulation.\nThe villages of Karluk and Larsen Bay are most likely to be\nimpacted.\n\nThose in sensitive groups or with respiratory ailments are\nencouraged to avoid or reduce outdoor activity to avoid inhaling\nthe ash. The winds will weaken slowly through the day Su",
        "severity": "Moderate",
        "certainty": "Observed",
        "urgency": "Expected",
        "sender": "NWS Anchorage AK",
        "effective": "2026-08-29T19:38:00-08:00",
        "expires": "2026-08-30T12:00:00-08:00",
        "areas": "Kodiak Island Southwest",
        "category": "Met",
        "response": "Execute",
        "instruction": "",
        "lat": null,
        "lng": null
      }

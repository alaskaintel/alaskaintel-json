        "id": "urn:oid:2.49.0.1.840.0.ed606c3ced6fbdbbc7aa4df3c8296e58842ac4d6.001.2",
        "event": "Red Flag Warning",
        "headline": "Red Flag Warning issued June 12 at 9:37AM AKDT until June 14 at 10:00PM AKDT by NWS Fairbanks AK",
        "description": "* AFFECTED AREA...Delta Junction.\n\n* TIMING...From 12 PM to 10 PM AKDT Saturday, and 12 PM to 10 PM\nAKDT Sunday.\n\n* WINDS...Saturday, South 20 to 30 mph with gusts up to 45 mph.\nSunday, South 30 to 40 mph with gusts up to 55 mph.\n\n* HUMIDITY...Minimum values between 20 and 25 percent.\n\n* TEMPERATURES...Highs in the mid to upper 70s. Lows in the\nlower 50s.\n\n* IMPACTS...Critical fire weather conditions are possible due to\na combination of low relative humidity, gusty winds from the\nsouth, and dry ",
        "severity": "Severe",
        "certainty": "Likely",
        "urgency": "Expected",
        "sender": "NWS Fairbanks AK",
        "effective": "2026-06-12T09:37:00-08:00",
        "expires": "2026-06-13T16:00:00-08:00",
        "areas": "Delta Junction",
        "category": "Met",
        "response": "Prepare",
        "instruction": "A Red Flag Warning means that conditions are occurring or will\noccur which could lead to the development of large and dangerous\nfires. It is directed toward fire agencies, and through them, to\nthe public.\n\nPlease advise the appropriate officials or fire crews in the\nfield of this Red Flag Warning.",
        "lat": null,
        "lng": null
      },

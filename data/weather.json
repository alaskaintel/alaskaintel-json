        "event": "Winter Weather Advisory",
        "headline": "Winter Weather Advisory issued November 25 at 6:33AM AKST until November 27 at 3:00PM AKST by NWS Fairbanks AK",
        "description": "* WHAT...Blowing Snow. Winds gusting as high as 45 mph.\n\n* WHERE...Central and Eastern Beaufort Sea Coast.\n\n* WHEN...Until 3 PM AKST Friday.\n\n* IMPACTS...Areas of blowing snow could significantly reduce\nvisibility.\n\n* ADDITIONAL DETAILS...No additional falling snow is expected. Strong\nwinds will blow snow already on the ground to create areas of low\nvisibility near the surface. A brief decrease in winds is expected\nWednesday before winds strengthen once more Thursday.",
        "severity": "Moderate",
        "certainty": "Likely",
        "urgency": "Expected",
        "sender": "NWS Fairbanks AK",
        "effective": "2026-11-25T06:33:00-09:00",
        "expires": "2026-11-25T16:00:00-09:00",
        "areas": "Central Beaufort Sea Coast; Eastern Beaufort Sea Coast",
        "category": "Met",
        "response": "Execute",
        "instruction": "Use caution while traveling, especially in open areas.",
        "lat": null,
        "lng": null
      },

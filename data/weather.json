      {
        "id": "urn:oid:2.49.0.1.840.0.ea8ca56f4d62fb0f5bbefbfb987da04cac562977.001.1",
        "event": "Winter Weather Advisory",
        "headline": "Winter Weather Advisory issued September 30 at 5:56AM AKDT until October 1 at 10:00PM AKDT by NWS Fairbanks AK",
        "description": "* WHAT...Snow expected. Total snow accumulations between 6 and 11\ninches.\n\n* WHERE...Eastern Alaska Range.\n\n* WHEN...From 4 PM this afternoon to 10 PM AKDT Thursday.\n\n* IMPACTS...Travel could be very difficult to impossible. Roads, and\nespecially bridges and overpasses, will likely become slick and\nhazardous.\n\n* ADDITIONAL DETAILS...Snow may melt initially Wednesday afternoon\nbut will quickly begin to accumulate Wednesday night as\ntemperatures drop below freezing with moderate to heavy snow\nfall",
        "severity": "Moderate",
        "certainty": "Likely",
        "urgency": "Expected",
        "sender": "NWS Fairbanks AK",
        "effective": "2026-09-30T05:56:00-08:00",
        "expires": "2026-09-30T21:00:00-08:00",
        "areas": "Eastern Alaska Range North of Trims Camp; Eastern Alaska Range South of Trims Camp",
        "category": "Met",
        "response": "Execute",
        "instruction": "Slow down and use caution while traveling. Visit 511.alaska.gov or\ncall 5 1 1 for the latest road conditions.",
        "lat": null,
        "lng": null
      },
      {
        "id": "urn:oid:2.49.0.1.840.0.5630d5731a8a05af071aaf87c104ac21ef19016a.001.1",
        "event": "Special Weather Statement",
        "headline": "Special Weather Statement issued September 29 at 3:16PM AKDT by NWS Fairbanks AK",
        "description": "Other than a couple of lingering sprinkles and flurries, most of\nthe area is drying out tonight. Temperatures will be noticeably\ncolder Wednesday morning as most spots drop into mid/upper 20s.\nAnother front will bring light snow to the Interior Wednesday\nnight into Thursday morning. Generally, about 1 inch or less is\nexpected around Fairbanks. Towards the Chena Rec Area, Chena Hot\nSprings, White Mountains and Fortymile Country, snow totals will\nbe around 1 to 3 inches.",
        "severity": "Moderate",
        "certainty": "Observed",
        "urgency": "Expected",
        "sender": "NWS Fairbanks AK",
        "effective": "2026-09-29T15:16:00-08:00",
        "expires": "2026-09-30T07:00:00-08:00",
        "areas": "Dalton Highway Summits; White Mountains and High Terrain South of the Yukon River; Fortymile Country; Upper Chena River Valley; Eielson AFB and Salcha; Chatanika River Valley; Two Rivers; Fairbanks Metro Area",

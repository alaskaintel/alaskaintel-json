      {
        "id": "urn:oid:2.49.0.1.840.0.c1b0d70d0d549c83f563d580756856680f0ad064.001.1",
        "event": "Red Flag Warning",
        "headline": "Red Flag Warning issued June 26 at 9:07AM AKDT until June 27 at 3:00AM AKDT by NWS Fairbanks AK",
        "description": "The National Weather Service in Fairbanks has issued a Red Flag\nWarning for lightning, which is in effect from 1 PM Friday\nafternoon to 3 AM AKDT Saturday.\n\n* AFFECTED AREA...Lower Yukon River, Middle Yukon Valley, Lower\nYukon and Innoko Valleys and Upper Kuskokwim Valley.\n\n* TIMING...From 1 PM Friday afternoon to 3 AM AKDT Saturday.\n\n* THUNDERSTORM COVERAGE INDEX...Numerous\n\n* WINDS...Northwest 8 to 15 mph.\n\n* HUMIDITY...As low as 35 percent.\n\n* TEMPERATURES...Highs in the mid 70s to near 80.\n\n",
        "severity": "Severe",
        "certainty": "Likely",
        "urgency": "Expected",
        "sender": "NWS Fairbanks AK",
        "effective": "2026-06-26T09:07:00-08:00",
        "expires": "2026-06-27T03:00:00-08:00",
        "areas": "Lower Yukon River; Middle Yukon Valley; Lower Yukon and Innoko Valleys; Upper Kuskokwim Valley",
        "category": "Met",
        "response": "Prepare",
        "instruction": "A Red Flag Warning means that conditions are occurring or will\noccur which could lead to the development of large and dangerous\nfires. It is directed toward fire agencies, and through them, to\nthe public.\n\nPlease advise the appropriate officials or fire crews in the\nfield of this Red Flag Warning.",
        "lat": null,
        "lng": null
      }

      },
      {
        "id": "urn:oid:2.49.0.1.840.0.1b9f8ede73e8679a0ed6f0c9b26f174e3ae3ec74.001.1",
        "event": "Winter Weather Advisory",
        "headline": "Winter Weather Advisory issued September 29 at 12:33PM AKDT until October 1 at 10:00PM AKDT by NWS Fairbanks AK",
        "description": "* WHAT...Snow expected. Total snow accumulations between 6 and 11\ninches.\n\n* WHERE...Eastern Alaska Range.\n\n* WHEN...From 4 PM Wednesday to 10 PM AKDT Thursday.\n\n* IMPACTS...Travel could be very difficult to impossible. Roads, and\nespecially bridges and overpasses, will likely become slick and\nhazardous.\n\n* ADDITIONAL DETAILS...Snow may melt initially Wednesday afternoon\nbut will quickly begin to accumulate overnight as temperatures drop\nbelow freezing with moderate to heavy snow falling. Snowfa",
        "severity": "Moderate",
        "certainty": "Likely",
        "urgency": "Expected",
        "sender": "NWS Fairbanks AK",
        "effective": "2026-09-29T12:33:00-08:00",
        "expires": "2026-09-30T07:00:00-08:00",
        "areas": "Eastern Alaska Range North of Trims Camp; Eastern Alaska Range South of Trims Camp",
        "category": "Met",
        "response": "Execute",
        "instruction": "Slow down and use caution while traveling. Visit 511.alaska.gov or\ncall 5 1 1 for the latest road conditions.",
        "lat": null,
        "lng": null
      }

      {
        "id": "urn:oid:2.49.0.1.840.0.f31aebe9fea25277c0dd069cb1057201cbe059ef.001.1",
        "event": "Special Weather Statement",
        "headline": "Special Weather Statement issued August 29 at 6:25AM AKDT by NWS Fairbanks AK",
        "description": "As rainfall moves east out of the Central Interior and Fairbanks\nNorth Star Borough, drier air will continue to bring gusty winds.\nGusty west-southwest in the 25 to 35 mph range are expected to\ncontinue through tonight. Early this morning, deeper valleys may\nsee lighter winds, but occasional gusts in the 25 to 35 mph range\nwill still be possible. Winds will weaken this evening and\novernight into Sunday.",
        "severity": "Moderate",
        "certainty": "Observed",
        "urgency": "Expected",
        "sender": "NWS Fairbanks AK",
        "effective": "2026-08-29T06:25:00-08:00",
        "expires": "2026-08-29T22:00:00-08:00",
        "areas": "White Mountains and High Terrain South of the Yukon River; Upper Chena River Valley; Tanana Flats; Eielson AFB and Salcha; Goldstream Valley and Nenana Hills; Chatanika River Valley; Two Rivers; Fairbanks Metro Area; Nenana; Central Interior",
        "category": "Met",
        "response": "Execute",
        "instruction": "",
        "lat": null,
        "lng": null
      },
      {
        "id": "urn:oid:2.49.0.1.840.0.e7c5eaae31a9387c6cb865edf11e0949a4f96b7d.001.1",
        "event": "Winter Weather Advisory",
        "headline": "Winter Weather Advisory issued August 29 at 6:13AM AKDT until August 29 at 4:00PM AKDT by NWS Fairbanks AK",
        "description": "* WHAT...Snow and blowing snow. Additional snow accumulations up to 2\ninches at or above pass level. Wind gusts up to 35 mph. Periods of\nblowing and falling snow could reduce visibility to 1/2 mile or\nless at times. Pockets of wintry mix are possible below pass level.\n\n* WHERE...Central Brooks Range, primarily Atigun Pass.\n\n* WHEN...Until 4 PM AKDT this afternoon.\n\n* IMPACTS...Travel could be difficult.\n\n* ADDITIONAL DETAILS...Blowing snow is most likely above 4000 feet\nnear the top of Atigun Pa",
        "severity": "Moderate",
        "certainty": "Likely",
        "urgency": "Expected",
        "sender": "NWS Fairbanks AK",
        "effective": "2026-08-29T06:13:00-08:00",
        "expires": "2026-08-29T16:00:00-08:00",
        "areas": "Central Brooks Range",
        "category": "Met",
        "response": "Execute",
        "instruction": "Slow down and use caution while traveling. Visit 511.alaska.gov or\ncall 5 1 1 for the latest road conditions.",
        "lat": null,
        "lng": null
      }
    ]

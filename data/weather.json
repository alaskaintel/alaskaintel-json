      {
        "id": "urn:oid:2.49.0.1.840.0.5bab2e914defc1baea154c2853cbc31ffb5dc5c3.001.1",
        "event": "Flood Advisory",
        "headline": "Flood Advisory issued July 24 at 10:59PM AKDT until July 25 at 11:00PM AKDT by NWS Anchorage AK",
        "description": "* WHAT...Flooding caused by excessive rainfall is occurring.\n\n* WHERE...Little Susitna River from the Parks Highway downstream.\n\n* WHEN...Until 1100 PM AKDT Saturday.\n\n* IMPACTS...Minor flooding in low-lying and poor drainage areas.\n\n* ADDITIONAL DETAILS...\n- At 1054 PM AKDT, river gauge reports indicate rises in water\nlevels from heavy rain across the advisory area. Minor\nflooding is ongoing or expected to begin shortly.\n- The crest is expected to occur near the Parks Highway\novernight tonight ",
        "severity": "Minor",
        "certainty": "Likely",
        "urgency": "Expected",
        "sender": "NWS Anchorage AK",
        "effective": "2026-07-24T22:59:00-08:00",
        "expires": "2026-07-25T23:00:00-08:00",
        "areas": "Lower Matanuska Valley; Southern Susitna Valley",
        "category": "Met",
        "response": "Avoid",
        "instruction": "Stay tuned to further developments by listening to your local radio,\ntelevision, or NOAA Weather Radio for further information.",
        "lat": 61.4878947368421,
        "lng": -150.12105263157892
      },
      {
        "id": "urn:oid:2.49.0.1.840.0.bde07f44765de3c150831a6dbba407e140602ce7.001.1",
        "event": "Special Weather Statement",
        "headline": "Special Weather Statement issued July 24 at 3:15PM AKDT by NWS Fairbanks AK",
        "description": "A cold front is expected to move southeast from the Chukchi Sea\nSaturday night into Sunday, northwesterly winds are expected to\nincrease across the Kotzebue Sound. Gusts on Sunday are expected\nto be between 30 and 40 mph. With this, water levels could rise to\nas high as 2 ft above the normal high tide line, with the highest\nlevels in the Kotzebue Sound.",
        "severity": "Moderate",
        "certainty": "Observed",
        "urgency": "Expected",
        "sender": "NWS Fairbanks AK",
        "effective": "2026-07-24T15:15:00-08:00",
        "expires": "2026-07-25T16:00:00-08:00",
        "areas": "Kivalina and Red Dog Dock; Baldwin Peninsula; Northern Seward Peninsula; Shishmaref",
        "category": "Met",
        "response": "Execute",
        "instruction": "",
        "lat": null,
        "lng": null
      },
      {
        "id": "urn:oid:2.49.0.1.840.0.4818da803bcf1cddd170245d2b6a6757ccc0125d.001.1",
        "event": "Special Weather Statement",
        "headline": "Special Weather Statement issued July 24 at 3:15PM AKDT by NWS Fairbanks AK",
        "description": "Another Arctic cold front is expected to move southeast from the\nChukchi Sea Saturday night into Sunday. Starting off, most of the\nprecipitation will be rain and then transition to snow Saturday\nnight into early Sunday morning. During this transition, there is\na slight chance for sleet and/or freezing drizzle to fall along\nthe eastern Arctic Coast. 2-4\" of snow is possible in the Brooks\nRange and a coating to 2\" across the Arctic Coast.",
        "severity": "Moderate",
        "certainty": "Observed",
        "urgency": "Expected",
        "sender": "NWS Fairbanks AK",
        "effective": "2026-07-24T15:15:00-08:00",
        "expires": "2026-07-25T16:00:00-08:00",
        "areas": "Central Beaufort Sea Coast; Central Arctic Plains; Central Brooks Range; Romanzof Mountains",
        "category": "Met",

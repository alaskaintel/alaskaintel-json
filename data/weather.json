      {
        "id": "urn:oid:2.49.0.1.840.0.284f8c878555de8dcbd7b5ba23aa02e869d8f7b5.001.1",
        "event": "Special Weather Statement",
        "headline": "Special Weather Statement issued July 25 at 2:56PM AKDT by NWS Fairbanks AK",
        "description": "A cold front is expected to move southeast from the Chukchi Sea\nSaturday night through Sunday morning. Gusty northwesterly winds\nare expected across the Kotzebue Sound and Chukchi Sea Coast\nSunday following the front. Gusts on Sunday are expected to be\nbetween 25 and 35 mph. Water levels are expected to rise to 1 to\n1.5 feet above the normal high tide line late Sunday, peaking\novernight and diminishing rapidly Monday morning.",
        "severity": "Moderate",
        "certainty": "Observed",
        "urgency": "Expected",

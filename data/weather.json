        "event": "Special Weather Statement",
        "headline": "Special Weather Statement issued June 11 at 3:05AM AKDT by NWS Juneau AK",
        "description": "A low pressure system will bring increased moisture toward Yakutat\nand the northern gulf coast this weekend. This event will not be\nlong in duration, lasting around 24 to 48 hours. It will bring\nheavy rain during most of the event, with the most likely scenario\nbeing 2 to 3 inches of rain over 24 hours. There is a 60% chance\nof greater than 2 inches in 24 hours and similarly a 60% chance of\ngreater than 3 inches of rain in 48 hours. That being said, no\nflooding is expected at this time. There is",
        "severity": "Moderate",
        "certainty": "Observed",
        "urgency": "Expected",
        "sender": "NWS Juneau AK",
        "effective": "2026-06-11T03:05:00-08:00",
        "expires": "2026-06-11T16:00:00-08:00",
        "areas": "City and Borough of Yakutat",
        "category": "Met",
        "response": "Execute",
        "instruction": "",
        "lat": null,
        "lng": null
      },

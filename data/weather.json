      {
        "id": "urn:oid:2.49.0.1.840.0.907719541a029a08e61aebf035a7effbbb82ffdc.001.1",
        "event": "Special Weather Statement",
        "headline": "Special Weather Statement issued June 22 at 10:08PM AKDT by NWS Juneau AK",
        "description": "Continuing snow melt across the Chilkat River Valley has led to\nelevated flow in rivers and streams within the area. The Klehini\nRiver in particular has experienced flow rates in excess of 6,000 CFS\nat times. While temperatures will cool down through the upcoming\nweek, snow levels in excess of 5,000 ft will continue to support\nadditional runoff entering the Chilkat River Valley, maintaining\nelevated stream flow.\n\n\nFor the Klehini River Near Klukwan:\nAt 9:00pm the stage was 86.7 feet.",
        "severity": "Moderate",
        "certainty": "Observed",
        "urgency": "Expected",
        "sender": "NWS Juneau AK",
        "effective": "2026-06-22T22:08:00-08:00",
        "expires": "2026-06-23T22:00:00-08:00",
        "areas": "Haines Borough and Klukwan",
        "category": "Met",
        "response": "Execute",
        "instruction": "",
        "lat": null,
        "lng": null
      },
      {
